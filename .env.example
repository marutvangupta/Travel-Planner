# Everything is optional. With no keys the app runs on the bundled demo dataset and the built-in planner.

# --- LLM planning (OpenAI). Without it the deterministic planner is used.
OPENAI_API_KEY=
OPENAI_MODEL_PLAN=gpt-4.1          # planning and repair
OPENAI_MODEL_FAST=gpt-4.1-mini     # routing, replacement choice, Q&A, judge
# Override token prices (USD per 1M tokens) used for cost tracking if they change:
# MODEL_PRICES_JSON={"gpt-4.1":[2.0,8.0],"gpt-4.1-mini":[0.4,1.6]}

# --- Live places and routing (Google Maps Platform: Places API (New) + Routes API + Geocoding API)
GOOGLE_MAPS_API_KEY=
# --- Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Infrastructure
DATABASE_URL=sqlite:///./travel_planner.db      # docker compose uses PostgreSQL + pgvector
REDIS_URL=                                      # optional; falls back to an in-memory cache
TOOLS_MODE=inprocess                            # or "mcp" to call tools through the MCP server
MCP_SERVER_URL=http://localhost:8001/mcp
SECRET_KEY=change-me
ENV=dev                                         # ENV=prod refuses to start with the default SECRET_KEY
DAILY_RUN_QUOTA=60
WEATHER_WATCH_INTERVAL_MIN=0                    # >0 enables the background weather watcher
